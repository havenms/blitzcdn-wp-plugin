# Example environment file for BlitzCDN Middleware
# Copy this file to .env and fill in your values

# Appwrite Configuration
APPWRITE_PROJECT_ID=blitz-cdn
APPWRITE_API_KEY=standard_0915a1c42d339dcbdcf4fb16e8b1d56580f444b22e136ce28b3db1d304162ea936f9b11ef4f12ca57c04a37d63fad24254e7d7252a8b946b909c4eba077ba9a2e75ecded23cf91d796a6f1eb2c46ae0940936065960040881a13f766c66340def569aeb767d31800ba23d9b0920381a2024d5a03f3a985e585a73601f6414428
APPWRITE_BUCKET_ID=blob
APPWRITE_ENDPOINT=https://apw.havenmediasolutions.com/v1
APPWRITE_CDN_DOMAIN=https://apw.havenmediasolutions.com/v1
APPWRITE_DB_ID=db
APPWRITE_COLLECTION_ID=uploads

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Optional host port overrides
# MIDDLEWARE_HOST_PORT=51729
# REDIS_HOST_PORT=54873

# Redis Configuration (for persistent job queue)
# Set via docker-compose.yml environment when using Docker
REDIS_URL=redis://localhost:6379

# Data directory for temporary job files
DATA_DIR=./data

# Security
API_KEY=your-middleware-api-key

# Performance
BATCH_SIZE=10
PARALLEL_UPLOADS=5
MAX_RETRIES=3
MAX_ZIP_SIZE_MB=4096